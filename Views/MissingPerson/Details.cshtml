@model DaNangSafeMap.Models.Entities.MissingPerson
@{
    ViewData["Title"] = "Chi Tiết - " + Model.FullName;

    string GetDesc(string key) {
        if (string.IsNullOrEmpty(Model.Description)) return "";
        var parts = Model.Description.Split('|');
        foreach (var p in parts) {
            if (p.StartsWith(key + ":")) return p.Substring(key.Length + 1);
        }
        return "";
    }

    var age     = GetDesc("TUOI");
    var gender  = GetDesc("GIOITINH");
    var height  = GetDesc("CHIEUCAO");
    var feature = GetDesc("DACBIET");
    var contact = GetDesc("LIENHE");
    var content = GetDesc("NOIDUNG");

    bool isFound     = Model.Status == 2;
    bool isSearching = Model.Status == 1;
    var personId     = Model.Id;
    var ownerId      = Model.UserId;
}

<link rel="stylesheet" href="~/css/missing.css" asp-append-version="true" />

<div class="mp-detail-page">
  <div class="mp-detail-card">
    <a href="/MissingPerson" class="mp-back-btn">
        <svg viewBox="0 0 24 24"><polyline points="15 18 9 12 15 6"/></svg>
        Quay lại danh sách
    </a>

    @if (TempData["Success"] != null)
    {
        <div class="mp-alert mp-alert--success">✅ @TempData["Success"]</div>
    }
    @if (TempData["Error"] != null)
    {
        <div class="mp-alert mp-alert--error">⚠️ @TempData["Error"]</div>
    }

    <div class="mp-detail-layout">
      <!-- ── LEFT ── -->
      <div class="mp-detail-left">
        <div class="mp-detail-photo">
          @if (!string.IsNullOrEmpty(Model.ImageUrl))
          { <img src="@Model.ImageUrl" alt="@Model.FullName" /> }
          else
          { <div class="mp-detail-no-photo">?</div> }
        </div>

        @if (isFound)
        {
          <div class="mp-status-badge mp-status-badge--found">🟢 ĐÃ TÌM THẤY</div>
        }
        else if (isSearching)
        {
          <div class="mp-status-badge mp-status-badge--searching">🔴 ĐANG TÌM KIẾM</div>
        }

        <!-- Nút hành động -->
        @if (isSearching)
        {
          <!-- Nút hành động: Gửi manh mối & Chat -->
          <div id="guestActions" class="mp-detail-actions" style="display:flex; flex-direction:column; gap:10px; margin-bottom:12px;">
            <button class="mp-btn-clue" onclick="openClueForm()" style="width:100%;">
              💡 GỬI MANH MỐI (ĐIỀN FORM)
            </button>
            <button class="mp-btn-clue" onclick="openChat()" style="width:100%; background:linear-gradient(135deg, #0d9488, #0f766e);">
              💬 CHAT TRỰc TIẾP TỚI NGƯỜI THÂN
            </button>
            <button class="mp-btn-report" onclick="openReportModal()" style="width:100%; background:#dc2626; color:#fff;">
              ⚠️ Báo cáo vi phạm
            </button>
          </div>

          <!-- Chức năng 5: Đánh dấu đã tìm thấy (chỉ chủ bài thấy) -->
          <div id="ownerActions" style="display:none; margin-bottom:10px;">
            <button class="mp-btn-resolve" onclick="showResolveModal()">
              ✅ Đánh dấu đã tìm thấy
            </button>
          </div>
        }

        <!-- Báo cáo -->
        <button class="mp-btn-report" onclick="alert('Chức năng báo cáo đang phát triển')">
          ⚑ Báo cáo vi phạm
        </button>
      </div>

      <!-- ── RIGHT ── -->
      <div class="mp-detail-right">
        <h1 class="mp-detail-name">@Model.FullName</h1>
        <p class="mp-detail-time">⏰ Đăng lúc @Model.CreatedAt.ToString("HH:mm dd/MM/yyyy")</p>

        <div class="mp-info-section">
          <h3>📋 Thông tin cơ bản</h3>
          <div class="mp-info-grid">
            @if (!string.IsNullOrEmpty(age))
            { <div class="mp-info-item"><span class="mp-info-label">Tuổi</span><span class="mp-info-value">@age tuổi</span></div> }
            @if (!string.IsNullOrEmpty(gender))
            { <div class="mp-info-item"><span class="mp-info-label">Giới tính</span><span class="mp-info-value">@gender</span></div> }
            @if (!string.IsNullOrEmpty(height) && height != "")
            { <div class="mp-info-item"><span class="mp-info-label">Chiều cao</span><span class="mp-info-value">@height cm</span></div> }
            <div class="mp-info-item"><span class="mp-info-label">Địa điểm mất tích</span><span class="mp-info-value">📍 @Model.LastSeenLocation</span></div>
          </div>
        </div>

        @if (!string.IsNullOrEmpty(feature))
        {
          <div class="mp-info-section">
            <h3>🔍 Đặc điểm nhận dạng</h3>
            <p class="mp-detail-text">@feature</p>
          </div>
        }

        @if (!string.IsNullOrEmpty(content))
        {
          <div class="mp-info-section">
            <h3>📝 Nội dung bài viết</h3>
            <p class="mp-detail-text">@content</p>
          </div>
        }

        @if (!string.IsNullOrEmpty(contact))
        {
          <div class="mp-info-section mp-contact-box">
            <h3>📞 Thông tin liên hệ</h3>
            <p class="mp-contact-info">@contact</p>
          </div>
        }

        @if (Model.User != null)
        {
          <div class="mp-info-section">
            <h3>👤 Người đăng bài</h3>
            <p>@Model.User.FullName</p>
          </div>
        }

        <!-- ══ CHỨC NĂNG 3: DANH SÁCH MANH MỐI (chỉ owner thấy) ══ -->
        <div id="clueSection" style="display:none;">
          <div class="mp-info-section">
            <h3 id="clueTitle">📌 CÁC MANH MỐI ĐÃ NHẬN</h3>
            <div id="clueList" class="mp-clue-list">
              <p class="mp-loading">Đang tải...</p>
            </div>
          </div>
        </div>

        <!-- ══ CHỨC NĂNG 4: DANH SÁCH CHAT VÀ POLLING (chỉ owner thấy) ══ -->
        <div id="chatRoomSection" style="display:none; margin-top:24px;">
          <div class="mp-info-section">
            <h3 id="chatRoomTitle">💬 TIN NHẮN TỪ CỘNG ĐỒNG <span id="unreadBadge" class="mp-badge-red" style="display:none;"></span></h3>
            <div id="chatRoomList" class="mp-clue-list">
              <p class="mp-loading">Đang tải tin nhắn...</p>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</div>

<!-- ══ MODAL: Báo cáo vi phạm (Chức năng 6) ══ -->
<div class="mp-modal-overlay" id="reportModal" style="display:none;">
  <div class="mp-modal mp-modal--sm">
    <div class="mp-modal-header">
      <h3>⚠️ BÁO CÁO VI PHẠM</h3>
      <button class="mp-modal-close" onclick="closeReportModal()">✕</button>
    </div>
    <div class="mp-modal-body" style="padding:20px; overflow-y:auto; max-height:75vh;">
      <form id="reportForm" onsubmit="submitReport(event)">
        <div class="mp-form-group" style="margin-bottom:12px;">
          <label style="font-weight:bold;">Lý do báo cáo:</label><br>
          <input type="radio" name="reason" value="Thông tin giả mạo / Lừa đảo" required> Thông tin giả mạo / Lừa đảo<br>
          <input type="radio" name="reason" value="Spam"> Spam<br>
          <input type="radio" name="reason" value="Nội dung không phù hợp"> Nội dung không phù hợp<br>
          <input type="radio" name="reason" value="Khác"> Khác
        </div>
        <div class="mp-form-group" style="margin-bottom:12px;">
          <label style="font-weight:bold;">Chi tiết (nếu chọn Khác):</label>
          <textarea id="reportDetails" class="mp-input mp-textarea" rows="3" placeholder="Mô tả chi tiết..."></textarea>
        </div>
        <div style="text-align:right; margin-top:20px;">
          <button type="button" class="mp-btn-cancel" onclick="closeReportModal()">Hủy</button>
          <button type="submit" class="mp-btn-submit" style="background:#dc2626; color:#fff;">Gửi báo cáo</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ══ MODAL: Gửi manh mối (Chức năng 3) ══ -->
<div class="mp-modal-overlay" id="clueModal" style="display:none;">
  <div class="mp-modal mp-modal--sm">
    <div class="mp-modal-header">
      <h3>💡 GỬI MANH MỐI</h3>
      <button class="mp-modal-close" onclick="closeClueForm()">✕</button>
    </div>
    <div class="mp-modal-body" style="padding:20px; overflow-y:auto; max-height:75vh;">
      <form id="submitClueForm" onsubmit="submitClueData(event)">
        <div class="mp-form-group" style="margin-bottom:12px;">
          <label style="font-weight:bold; font-size:0.85rem; display:block; margin-bottom:5px;">Địa điểm thấy <span class="required">*</span></label>
          <input type="text" id="clueLocation" class="mp-input" required placeholder="VD: Công viên 29/3, Đà Nẵng">
        </div>
        <div class="mp-form-group" style="margin-bottom:12px;">
          <label style="font-weight:bold; font-size:0.85rem; display:block; margin-bottom:5px;">Thời gian thấy <span class="required">*</span></label>
          <input type="datetime-local" id="clueSeenAt" class="mp-input" required>
        </div>
        <div class="mp-form-group" style="margin-bottom:12px;">
          <label style="font-weight:bold; font-size:0.85rem; display:block; margin-bottom:5px;">Mô tả chi tiết <span class="required">*</span></label>
          <textarea id="clueContent" class="mp-input mp-textarea" required rows="3" placeholder="Mô tả đặc điểm người đó..."></textarea>
        </div>
        <div class="mp-form-group" style="margin-bottom:12px;">
          <label style="font-weight:bold; font-size:0.85rem; display:block; margin-bottom:5px;">Ảnh (không bắt buộc)</label>
          <input type="file" id="cluePhoto" class="mp-input" accept="image/*">
        </div>
        <div class="mp-form-group" style="margin-bottom:12px;">
          <label style="font-weight:bold; font-size:0.85rem; display:block; margin-bottom:5px;">Số điện thoại (nếu muốn người nhà liên lạc)</label>
          <input type="tel" id="cluePhone" class="mp-input" placeholder="Bỏ trống thì hệ thống gửi ẩn danh">
        </div>
        <div style="text-align:right; margin-top:20px;">
          <button type="submit" class="mp-btn-submit" id="btnSubmitClue">Gửi manh mối</button>
        </div>
      </form>
    </div>
  </div>
</div>

<!-- ══ MODAL: Mở chat (Chức năng 4) ══ -->
<div class="mp-modal-overlay" id="chatModal" style="display:none;">
  <div class="mp-modal">
    <div class="mp-modal-header">
      <h3 id="chatModalTitle">💬 Liên hệ về bài đăng</h3>
      <button class="mp-modal-close" onclick="closeChat()">✕</button>
    </div>

    <!-- Chat messages area -->
    <div class="mp-chat-messages" id="chatMessages">
      <div class="mp-chat-empty">Bắt đầu bằng cách gửi thông tin bạn biết về người này...</div>
    </div>

    <!-- Input -->
    <div class="mp-chat-input-area">
      <textarea id="chatInput" class="mp-chat-input" placeholder="Nhập tin nhắn..." rows="2"></textarea>
      <button class="mp-chat-send" onclick="sendMessage()">
        <svg viewBox="0 0 24 24"><path d="M22 2L11 13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
      </button>
    </div>
  </div>
</div>

<!-- ══ MODAL: Xác nhận đã tìm thấy (Chức năng 5) ══ -->
<div class="mp-modal-overlay" id="resolveModal" style="display:none;">
  <div class="mp-modal mp-modal--sm">
    <div class="mp-modal-header">
      <h3>✅ XÁC NHẬN ĐÃ TÌM THẤY</h3>
      <button class="mp-modal-close" onclick="document.getElementById('resolveModal').style.display='none'">✕</button>
    </div>
    <div class="mp-modal-body">
      <p>Bạn xác nhận đã tìm thấy <strong>@Model.FullName</strong>?</p>
      <p style="color:#64748b;font-size:0.88rem;">Sau khi xác nhận, bài đăng sẽ chuyển sang màu xanh và chức năng gửi manh mối sẽ bị khóa.</p>
      <div style="display:flex;gap:12px;margin-top:20px;justify-content:flex-end;">
        <button class="mp-btn-cancel" onclick="document.getElementById('resolveModal').style.display='none'">Hủy</button>
        <form asp-action="MarkResolved" asp-route-id="@personId" method="post" style="margin:0;">
          @Html.AntiForgeryToken()
          <button type="submit" class="mp-btn-submit">✅ Xác nhận</button>
        </form>
      </div>
    </div>
  </div>
</div>

@section Scripts {
<script>
// ─── Constants ────────────────────────────────────────────────────────
const PERSON_ID = @personId;
const OWNER_ID  = @ownerId;
let currentRoomId = null;
let pollingInterval = null;
let currentUserId = null;

// ─── Init ─────────────────────────────────────────────────────────────
(function init() {
    try {
        const user = JSON.parse(localStorage.getItem('user') || 'null');
        if (!user) return;
        currentUserId = user.id;

        // Nếu là owner → hiện nút "Đánh dấu đã tìm thấy" + load manh mối
        if (currentUserId == OWNER_ID) {
            document.getElementById('ownerActions')?.style && (document.getElementById('ownerActions').style.display = 'block');
            
            // Ẩn nút gửi manh mối & chat vì chính chủ không tự nhắn cho mình
            const guestActions = document.getElementById('guestActions');
            if (guestActions) guestActions.style.display = 'none';

            document.getElementById('clueSection').style.display = 'block';
            loadClues();
            loadChatRooms();
        }
    } catch(e) {}
})();

// ─── CHỨC NĂNG 5: Xác nhận đã tìm thấy ──────────────────────────────
function showResolveModal() {
    document.getElementById('resolveModal').style.display = 'flex';
}

// ─── CHỨC NĂNG 3: GỬI MANH MỐI BẰNG FORM ──────────
function openClueForm() {
    document.getElementById('clueModal').style.display = 'flex';
    document.getElementById('clueSeenAt').max = new Date().toISOString().slice(0, 16);
}

function closeClueForm() {
    document.getElementById('clueModal').style.display = 'none';
}

async function submitClueData(e) {
    e.preventDefault();
    const btn = document.getElementById('btnSubmitClue');
    btn.disabled = true;
    btn.textContent = 'Đang gửi...';

    const location = document.getElementById('clueLocation').value;
    const seenAt = document.getElementById('clueSeenAt').value;
    const content = document.getElementById('clueContent').value;
    const phone = document.getElementById('cluePhone').value;
    const photo = document.getElementById('cluePhoto').files[0];

    if (new Date(seenAt) >= new Date()) {
        alert("⚠️ CHÚ Ý: Thời gian thấy phải ở trong quá khứ!");
        btn.disabled = false; btn.textContent = 'Gửi manh mối';
        return;
    }

    const formData = new FormData();
    formData.append('MissingPersonId', PERSON_ID);
    formData.append('SeenLocation', location);
    formData.append('SeenAt', seenAt);
    formData.append('Content', content);
    if (phone) formData.append('Phone', phone);
    if (photo) formData.append('Photo', photo);

    try {
        const token = localStorage.getItem('token');
        const headers = token ? { 'Authorization': 'Bearer ' + token } : {};
        
        const res = await fetch('/api/clues', {
            method: 'POST',
            headers: headers,
            body: formData
        });

        if (res.ok) {
            alert('Cảm ơn bạn đã gửi manh mối!');
            closeClueForm();
            document.getElementById('submitClueForm').reset();
            if (currentUserId == OWNER_ID) loadClues(); // reload nếu tự test
        } else {
            const err = await res.json();
            alert('Lỗi: ' + (err.error || 'Vui lòng kiểm tra lại thông tin.'));
        }
    } catch {
        alert('Lỗi mạng không thể gửi manh mối!');
    }
    btn.disabled = false; btn.textContent = 'Gửi manh mối';
}

// ─── CHỨC NĂNG 6: Báo cáo vi phạm ────────────────────────────────────────
function openReportModal() {
    document.getElementById('reportModal').style.display = 'flex';
}
function closeReportModal() {
    document.getElementById('reportModal').style.display = 'none';
}
async function submitReport(e) {
    e.preventDefault();
    const form = e.target;
    const reason = form.reason.value;
    const details = document.getElementById('reportDetails').value;
    if (reason === 'Khác' && !details.trim()) {
        alert('Vui lòng nhập chi tiết cho lý do "Khác"');
        return;
    }
    const payload = {
        targetId: PERSON_ID,
        targetType: 'MissingPerson',
        reason: reason,
        details: details
    };
    try {
        const token = localStorage.getItem('token');
        const headers = { 'Content-Type': 'application/json' };
        if (token) headers['Authorization'] = 'Bearer ' + token;
        const res = await fetch('/api/reports', {
            method: 'POST',
            headers: headers,
            body: JSON.stringify(payload)
        });
        if (res.ok) {
            alert('Cảm ơn bạn đã báo cáo!');
            closeReportModal();
        } else {
            const err = await res.json();
            alert('Lỗi: ' + (err.error || 'Vui lòng thử lại'));
        }
    } catch (ex) {
        console.error('Report error', ex);
        alert('Có lỗi xảy ra khi gửi báo cáo');
    }
}

async function openChat() {
    const token = localStorage.getItem('token');
    if (!token) {
        alert('Bạn cần đăng nhập để liên hệ!');
        window.location.href = '/Auth/Login';
        return;
    }

    // Tạo/mở phòng chat
    const res = await fetch('/api/chat/open-room', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
        body: JSON.stringify({ missingPersonId: PERSON_ID })
    });

    if (!res.ok) { 
        if (res.status === 401) {
            alert('Phiên đăng nhập đã hết hạn. Vui lòng đăng nhập lại!');
            localStorage.removeItem('token');
            window.location.href = '/Auth/Login';
        } else {
            alert('Không thể mở chat, vui lòng thử lại sau'); 
        }
        return; 
    }

    const data = await res.json();
    currentRoomId = data.roomId;

    document.getElementById('chatModal').style.display = 'flex';
    await loadMessages();

    // Bắt đầu polling 5s
    pollingInterval = setInterval(loadMessages, 5000);

    // Đánh dấu đã đọc
    markRead();
}

function closeChat() {
    document.getElementById('chatModal').style.display = 'none';
    clearInterval(pollingInterval);
    pollingInterval = null;
}

async function loadMessages() {
    if (!currentRoomId) return;
    const token = localStorage.getItem('token');

    const res = await fetch(`/api/chat/messages/${currentRoomId}`, {
        headers: { 'Authorization': 'Bearer ' + token }
    });
    if (!res.ok) return;

    const msgs = await res.json();
    const container = document.getElementById('chatMessages');

    if (!msgs.length) {
        container.innerHTML = '<div class="mp-chat-empty">Bắt đầu bằng cách gửi thông tin bạn biết về người này...</div>';
        return;
    }

    container.innerHTML = msgs.map(m => {
        const isMine = m.senderId == currentUserId;
        return `<div class="mp-chat-msg ${isMine ? 'mine' : 'theirs'}">
            <span class="mp-chat-sender">${isMine ? 'Bạn' : m.senderName}</span>
            <div class="mp-chat-bubble">${m.message}</div>
            <span class="mp-chat-time">${m.sentAt}</span>
        </div>`;
    }).join('');

    container.scrollTop = container.scrollHeight;
}

async function sendMessage() {
    const input = document.getElementById('chatInput');
    const sendBtn = document.querySelector('.mp-chat-send');
    const text = input.value.trim();
    
    if (!text || !currentRoomId || sendBtn.disabled) return;

    // Ngăn gửi nhiều lần: clear input và disable nút Gửi ngay lập tức
    input.value = '';
    sendBtn.disabled = true;

    try {
        const token = localStorage.getItem('token');
        await fetch('/api/chat/send', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json', 'Authorization': 'Bearer ' + token },
            body: JSON.stringify({ roomId: currentRoomId, message: text })
        });
        await loadMessages();
    } catch (e) {
        console.error("Lỗi khi gửi:", e);
    } finally {
        sendBtn.disabled = false;
        input.focus();
    }
}

// Enter để gửi
document.getElementById('chatInput')?.addEventListener('keydown', function(e) {
    if (e.key === 'Enter' && !e.shiftKey) { e.preventDefault(); sendMessage(); }
});

async function markRead() {
    if (!currentRoomId) return;
    const token = localStorage.getItem('token');
    await fetch(`/api/chat/mark-read/${currentRoomId}`, {
        method: 'POST',
        headers: { 'Authorization': 'Bearer ' + token }
    });
}

// ─── CHỨC NĂNG 3: Load manh mối (chỉ owner) ─────────────────────────
async function loadClues() {
    const token = localStorage.getItem('token');
    const res = await fetch(`/api/clues/${PERSON_ID}`, {
        headers: { 'Authorization': 'Bearer ' + token }
    });
    if (!res.ok) return;

    const clues = await res.json();
    const title = document.getElementById('clueTitle');
    const list  = document.getElementById('clueList');

    title.textContent = `📌 CÁC MANH MỐI ĐÃ NHẬN (${clues.length} manh mối)`;

    if (!clues.length) {
        list.innerHTML = '<p style="color:#94a3b8;">Chưa có manh mối nào.</p>';
        return;
    }

    list.innerHTML = clues.map(c => `
        <div class="mp-clue-item">
            <div class="mp-clue-meta">
                <span class="mp-clue-sender">👤 ${c.senderName}</span>
                <span class="mp-clue-time">${new Date(c.createdAt).toLocaleString('vi-VN')}</span>
            </div>
            ${c.seenAt ? `<div>🕐 Thấy lúc: <strong>${c.seenAt}</strong></div>` : ''}
            ${c.location ? `<div>📍 Địa điểm: <strong>${c.location}</strong></div>` : ''}
            <div class="mp-clue-content">${c.content}</div>
            ${c.phone ? `<div>📞 Liên hệ: <strong>${c.phone}</strong></div>` : '<div style="color:#94a3b8;font-size:0.8rem;">Gửi ẩn danh</div>'}
            ${c.imageUrl ? `<img src="${c.imageUrl}" style="max-width:100%;border-radius:8px;margin-top:8px;" />` : ''}
        </div>
    `).join('');
}

// ─── CHỨC NĂNG 4: Danh sách phòng chat (cho chủ bài) ──────────────────
async function loadChatRooms(silentUpdate = false) {
    const token = localStorage.getItem('token');
    const res = await fetch(`/api/chat/rooms/${PERSON_ID}`, {
        headers: { 'Authorization': 'Bearer ' + token }
    });
    if (!res.ok) return;

    const rooms = await res.json();
    document.getElementById('chatRoomSection').style.display = 'block';
    
    // Nếu silentUpdate = true và list chưa thay đổi thẻ count thì bỏ qua để khỏi giật màn hình
    const list = document.getElementById('chatRoomList');
    const currentCount = list.children.length;
    if (silentUpdate && currentCount === rooms.length && rooms.length > 0) return;

    const title = document.getElementById('chatRoomTitle');
    
    if (!rooms.length) {
        list.innerHTML = '<p style="color:#94a3b8;">Chưa có người nào nhắn tin cung cấp manh mối.</p>';
        return;
    }

    list.innerHTML = rooms.map(r => `
        <div class="mp-clue-item" style="cursor:pointer; border-left:3px solid var(--mp-teal);" onclick="openChatRoom(${r.id})">
            <div class="mp-clue-meta">
                <span class="mp-clue-sender">👤 Cộng đồng (Hộp thư ẩn danh)</span>
                <span class="mp-clue-time">Bắt đầu trò chuyện: ${new Date(r.createdAt).toLocaleString('vi-VN')}</span>
            </div>
            <div style="color:var(--mp-teal); font-weight:700; margin-top:8px; display:flex; gap:6px; align-items:center;">
                <svg viewBox="0 0 24 24" width="16" height="16" stroke="currentColor" fill="none" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                Bấm để mở tin nhắn
            </div>
        </div>
    `).join('');
}

async function openChatRoom(roomId) {
    currentRoomId = roomId;
    document.getElementById('chatModal').style.display = 'flex';
    document.getElementById('chatModalTitle').innerHTML = `💬 Trò chuyện với người cung cấp`;
    await loadMessages();
    if (pollingInterval) clearInterval(pollingInterval);
    pollingInterval = setInterval(loadMessages, 5000);
    markRead();
}
// Polling Global cho Owner để lấy Badge chưa đọc
setInterval(async () => {
    if (currentUserId == OWNER_ID) {
        checkUnreadOwner();
        // Cập nhật lại list phòng phòng trường hợp có phòng mới
        // (chỉ cập nhật nội dung nhẹ, không load ảnh hưởng trải nghiệm lớn)
        loadChatRooms(true); 
    }
}, 5000);

async function checkUnreadOwner() {
    const token = localStorage.getItem('token');
    if(!token) return;
    const res = await fetch(`/api/chat/check-unread?missingPersonIds=${PERSON_ID}`, {
        headers: { 'Authorization': 'Bearer ' + token }
    });
    if (res.ok) {
        const data = await res.json();
        const badge = document.getElementById('unreadBadge');
        if (data.count > 0) {
            badge.style.display = 'inline-block';
            badge.textContent = `🔴 ${data.count} chưa đọc`;
        } else {
            badge.style.display = 'none';
        }
    }
}
</script>
}
